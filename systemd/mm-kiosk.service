[Unit]
Description=MeldingsMonitor kazernescherm kiosk
After=network-online.target NetworkManager.service graphical.target lightdm.service mm-kiosk-web.service
Wants=network-online.target graphical.target mm-kiosk-web.service
Requires=network-online.target mm-kiosk-web.service

[Service]
Type=simple
Environment=MM_KIOSK_CONFIG=/etc/meldingsmonitor-kiosk/config.json
Environment=MM_KIOSK_SCRIPTS=/opt/meldingsmonitor-kiosk/scripts
ExecStart=/opt/meldingsmonitor-kiosk/scripts/mm-kiosk-boot.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
